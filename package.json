{
  "name": "safecircle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:mobile": "node -e \"require('child_process').execSync('next build', {stdio:'inherit', env: {...process.env, MOBILE_EXPORT:'true'}})\"",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:build": "node scripts/install_sdk_and_build.js",
    "build:apk": "npm run build:mobile && npx cap sync android && npm run apk:build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
